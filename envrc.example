# Run with: uvicorn main:app --host 0.0.0.0 --port 5000

# Websocket connection to Member Matters
DOORMAN_MM_ENABLE=true
DOORMAN_MM_ACCESS_URL=ws://membermatters.local/ws/access
DOORMAN_MM_DEVICE_NAME=frontdoor_test
DOORMAN_MM_API_KEY=super.secret

# Keep-alive ping interval (seconds). Pong timeout = 3× this value.
#DOORMAN_MM_PING_INTERVAL=30

# LDAP Configuration
DOORMAN_LDAP_ENABLE=true
DOORMAN_LDAP_SERVER=ipa.pawprint.space
DOORMAN_LDAP_USE_SSL=true

# Service account details for LDAP bind
DOORMAN_LDAP_USER_DN="uid=doorman,cn=sysaccounts,cn=etc,dc=pawprint,dc=space"
DOORMAN_LDAP_PASS=foobar

# Optional notification for LDAP lookup.  Leave unset to disable.
# https://appriseit.com/url-builder/
#DOORMAN_LDAP_APPRISE_URL=

DOORMAN_FANVIL_URL=https://fanvil.local
DOORMAN_FANVIL_USER=admin
DOORMAN_FANVIL_PASS=admin
# Unset to skip SSL verification
DOORMAN_FANVIL_CA=pawprint-ca.crt

# Sentry error reporting. Leave DSN unset to disable.
#DOORMAN_SENTRY_DSN=
#DOORMAN_SENTRY_ENVIRONMENT=production
#DOORMAN_SENTRY_RELEASE=
#DOORMAN_SENTRY_TRACES_SAMPLE_RATE=0.1

# Set to true in production for structured JSON log output (syslog-friendly).
#DOORMAN_LOG_JSON=true

# Uncomment for .envrc use:
#export DOORMAN_MM_ENABLE DOORMAN_MM_ACCESS_URL DOORMAN_MM_DEVICE_NAME DOORMAN_MM_API_KEY DOORMAN_MM_PING_INTERVAL
#export DOORMAN_LDAP_ENABLE DOORMAN_LDAP_SERVER DOORMAN_LDAP_USE_SSL DOORMAN_LDAP_USER_DN DOORMAN_LDAP_PASS
#export DOORMAN_FANVIL_URL DOORMAN_FANVIL_PASS DOORMAN_FANVIL_CA
